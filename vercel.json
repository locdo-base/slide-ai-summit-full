{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/logout",
      "destination": "/index.html"
    },
    {
      "source": "/auth/google",
      "destination": "/index.html"
    }
  ]
}
