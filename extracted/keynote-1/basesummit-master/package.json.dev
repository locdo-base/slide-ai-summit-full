{
  "name": "base-keynotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5801 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5802 --strictPort",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs work shots",
    "shoot": "node scripts/shoot.mjs"
  },
