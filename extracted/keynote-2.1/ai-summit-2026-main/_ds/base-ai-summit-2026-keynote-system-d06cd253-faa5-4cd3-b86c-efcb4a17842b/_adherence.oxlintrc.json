{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/diagram/**",
              "components/presenter/**",
              "components/stage/**",
              "components/surfaces/**",
              "components/typography/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Afacad))/i]",
        "message": "Font not provided by the design system. Available: Afacad."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|appkey|group|role|icon|state|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: name, appkey, group, role, icon, state, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|dim)$/]",
        "message": "<AppCard> state must be one of 'default' | 'active' | 'dim'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|video|poster|demo|caption|callouts|style|key|ref|className|style|children)$/]",
        "message": "<EvidenceFrame> doesn't accept that prop. Declared props: src, alt, video, poster, demo, caption, callouts, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|children|footer|state|reveal|delay|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: label, title, children, footer, state, reveal, delay, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|dim)$/]",
        "message": "<GlassCard> state must be one of 'default' | 'active' | 'dim'."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|action|state|result|status|last|onClick|style|key|ref|className|style|children)$/]",
        "message": "<JourneyStep> doesn't accept that prop. Declared props: index, title, action, state, result, status, last, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='JourneyStep'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:done|active|upcoming)$/]",
        "message": "<JourneyStep> status must be one of 'done' | 'active' | 'upcoming'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|source|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<Metric> doesn't accept that prop. Declared props: value, unit, label, source, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|cyan|green|orange)$/]",
        "message": "<Metric> tone must be one of 'white' | 'cyan' | 'green' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Metric> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresenterControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|onPrev|onNext|onOverview|onAutoplay|onNotes|onFullscreen|style|key|ref|className|style|children)$/]",
        "message": "<PresenterControls> doesn't accept that prop. Declared props: current, total, onPrev, onNext, onOverview, onAutoplay, onNotes, onFullscreen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionEyebrow> doesn't accept that prop. Declared props: tone, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|sub|muted)$/]",
        "message": "<SectionEyebrow> tone must be one of 'cyan' | 'sub' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|object|operator|state|output|status|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ServiceNode> doesn't accept that prop. Declared props: name, object, operator, state, output, status, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceNode'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:default|active|dim)$/]",
        "message": "<ServiceNode> status must be one of 'default' | 'active' | 'dim'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:deck|slideNo|total|glow|dots|animate|align|children|style|key|ref|className|style|children)$/]",
        "message": "<SlideShell> doesn't accept that prop. Declared props: deck, slideNo, total, glow, dots, animate, align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideShell'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:center|left|right|none)$/]",
        "message": "<SlideShell> glow must be one of 'center' | 'left' | 'right' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideShell'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<SlideShell> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageBackground'] > JSXAttribute > JSXIdentifier[name!=/^(?:glow|dots|children|style|key|ref|className|style|children)$/]",
        "message": "<StageBackground> doesn't accept that prop. Declared props: glow, dots, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageBackground'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:center|left|right|none)$/]",
        "message": "<StageBackground> glow must be one of 'center' | 'left' | 'right' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatementHighlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:h|key|ref|className|style|children)$/]",
        "message": "<StatementHighlight> doesn't accept that prop. Declared props: h."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
